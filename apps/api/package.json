{
  "name": "@spine/api",
  "version": "0.0.0",
  "private": true,
  "description": "Spine API and worker: a hexagonal modular monolith (Fastify, Kysely, BullMQ)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "openapi:generate": "tsx src/cli/openapi.ts ../../docs/architecture/openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.9.0",
    "@spine/enrichers": "workspace:*",
    "@spine/playbook-engine": "workspace:*",
    "@spine/shared-schema": "workspace:*",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "5.11.1",
    "jose": "6.2.13",
    "kysely": "0.28.18",
    "openapi-types": "12.1.3",
    "pg": "8.16.3",
    "pino": "9.14.0",
    "uuid": "11.1.1",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@testcontainers/redis": "11.14.0",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.12",
    "fast-check": "4.10.2",
    "testcontainers": "11.14.0",
    "tsx": "4.20.6"
  }
}
