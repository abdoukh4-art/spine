    "/api/v1/users/{id}": {
      "patch": {
        "summary": "Change a user’s role, display name, or disabled flag",
        "tags": [
          "users"
        ],
        "description": "409 if the change would leave no active admin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "viewer",
                      "analyst",
                      "admin"
                    ]
                  },
                  "disabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
