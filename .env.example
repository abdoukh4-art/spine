# Spine configuration (twelve-factor: all config via environment).
# Copy to .env for local development. NEVER commit real secrets.
# Every variable is validated at startup by apps/api/src/platform/config.ts.

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Set true only behind a trusted reverse proxy (nginx), so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443
RATE_LIMIT_MAX_PER_MINUTE=600
# Swagger UI at /docs (defaults to on outside production).
# ENABLE_API_DOCS=true

# --- Data stores ---
DATABASE_URL=postgres://spine:spine@localhost:5432/spine
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true
REDIS_URL=redis://localhost:6379

# --- Auth (ADR-0016) ---
# >= 32 random characters. Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-insecure-change-me-0123456789abcdef
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# Cookies need HTTPS when true. Use false only for plain-HTTP local development.
COOKIE_SECURE=false
# Login attempts per minute, per client IP and per username (429 + Retry-After beyond it).
AUTH_LOGIN_MAX_PER_MINUTE=10
# Seconds the API may cache a user between requests (0-30). Disabling a user or changing
# their role takes effect within this delay on other replicas (ADR-0060).
AUTH_USER_CACHE_TTL_SECONDS=30
# First-run admin: created ONLY when the users table is empty (ADR-0066). Dev values only;
# in production set a strong password from your secret store and remove it after first start.
BOOTSTRAP_ADMIN_EMAIL=admin@spine.test
BOOTSTRAP_ADMIN_PASSWORD=dev-only-insecure-bootstrap-password-0001

# --- Ingestion (ADR-0012, ADR-0024) ---
INGEST_MAX_BACKLOG=10000
# Webhook sources: id -> normalizer (canonical | suricata-eve | cef) + HMAC secret (>= 32 chars).
# Senders sign "<unix ts>.<raw body>" with HMAC-SHA256 (see docs/modules/ingestion.md).
WEBHOOK_SOURCES_JSON={"suricata":{"normalizer":"suricata-eve","secret":"dev-only-insecure-webhook-secret-suricata-0001"},"edr":{"normalizer":"canonical","secret":"dev-only-insecure-webhook-secret-edr-000000001"}}

# --- Worker / outbox ---
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
EVENT_WORKER_CONCURRENCY=8
PLAYBOOK_WORKER_CONCURRENCY=4
# How often the worker applies onTimeout to approvals past their deadline.
PLAYBOOK_APPROVAL_SWEEP_INTERVAL_MS=30000

# --- Simulation (ADR-0018) ---
SIMULATION_LATENCY_MS=50
SIMULATION_FAILURE_RATE=0

# --- Observability (ADR-0019) ---
METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

SHUTDOWN_TIMEOUT_MS=15000

# --- Docker Compose stack (infra/docker-compose.yml, docs/operations/deployment.md) ---
# Compose overrides DATABASE_URL / REDIS_URL for the containers from these values.
POSTGRES_USER=spine
POSTGRES_PASSWORD=spine
POSTGRES_DB=spine
# Grafana admin login (anonymous access is disabled). Change it.
GRAFANA_ADMIN_PASSWORD=dev-only-change-me-grafana
# Registry prefix for third-party images; mirror.gcr.io avoids Docker Hub rate limits.
# DOCKER_REGISTRY=docker.io
# CA bundle for image builds behind a TLS-intercepting proxy (BuildKit secret, never in a layer).
# BUILD_CA_FILE=/path/to/ca-bundle.crt
# Interface the published ports bind to (127.0.0.1 = this machine only).
# SPINE_BIND_ADDRESS=127.0.0.1
# HSTS max-age sent by nginx over TLS (0 for localhost; 63072000 in production).
# SPINE_HSTS_MAX_AGE=0
# Distributed tracing with Jaeger: enable the profile and point the OTLP exporter at it.
# COMPOSE_PROFILES=tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Set false only if the Alpine package CDN is unreachable from your build (see console.Dockerfile).
# APK_UPGRADE=true
