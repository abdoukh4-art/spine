# Spine configuration (twelve-factor: all config via environment).
# Copy to .env for local development. NEVER commit real secrets.
# Every variable is validated at startup by apps/api/src/platform/config.ts.

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Set true only behind a trusted reverse proxy (nginx), so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:8443
RATE_LIMIT_MAX_PER_MINUTE=600
# Swagger UI at /docs (defaults to on outside production).
# ENABLE_API_DOCS=true

# --- Data stores ---
DATABASE_URL=postgres://spine:spine@localhost:5432/spine
DATABASE_POOL_MAX=10
MIGRATE_ON_START=true
REDIS_URL=redis://localhost:6379

# --- Auth (ADR-0016) ---
# >= 32 random characters. Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-insecure-change-me-0123456789abcdef
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
# Cookies need HTTPS when true. Use false only for plain-HTTP local development.
COOKIE_SECURE=false

# --- Ingestion (ADR-0012, ADR-0024) ---
INGEST_MAX_BACKLOG=10000
# Webhook sources: id -> normalizer + HMAC secret (>= 32 chars).
WEBHOOK_SOURCES_JSON={"suricata":{"normalizer":"suricata-eve","secret":"dev-only-insecure-webhook-secret-suricata-0001"},"edr":{"normalizer":"canonical","secret":"dev-only-insecure-webhook-secret-edr-000000001"}}

# --- Worker / outbox ---
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=100
EVENT_WORKER_CONCURRENCY=8
PLAYBOOK_WORKER_CONCURRENCY=4

# --- Simulation (ADR-0018) ---
SIMULATION_LATENCY_MS=50
SIMULATION_FAILURE_RATE=0

# --- Enrichment (ADR-0014, ADR-0044, ADR-0045) ---
# Mock providers: simulated response time and probability [0..1] that a call fails with a
# transient error. The failures are drawn from a seeded PRNG, so a given seed fails the same calls.
# Try ENRICHMENT_FAILURE_RATE=0.6 to watch retries and circuit breakers at work.
ENRICHMENT_LATENCY_MS=30
ENRICHMENT_FAILURE_RATE=0
ENRICHMENT_SEED=42
# Budget of ONE attempt, and the number of attempts (first try included) for transient errors.
ENRICHMENT_TIMEOUT_MS=1000
ENRICHMENT_MAX_ATTEMPTS=3
# Lookups in flight at once for one alert (each provider also has its own bulkhead).
ENRICHMENT_CONCURRENCY=8

# --- Scoring (ADR-0015, ADR-0046) ---
# Ruleset file, relative to CONFIG_DIR (default "config", i.e. apps/api/config). Validated at
# startup: an invalid ruleset stops the process.
SCORING_RULESET_FILE=scoring/ruleset.v1.yaml

# --- Observability (ADR-0019) ---
METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

SHUTDOWN_TIMEOUT_MS=15000
